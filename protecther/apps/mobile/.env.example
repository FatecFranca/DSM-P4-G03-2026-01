# URL da API ProtectHer (lida em app.config.ts no momento do bundle)
# Ex.: emulador Android: http://10.0.2.2:3000
# Ex.: dispositivo na mesma rede: http://192.168.x.x:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Intervalo alvo de amostragem de GPS durante alerta ativo (ms), 5000–120000
EXPO_PUBLIC_LOCATION_INTERVAL_MS=15000
