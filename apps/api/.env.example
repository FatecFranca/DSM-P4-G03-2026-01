DATABASE_URL=postgresql://postgres:100342@127.0.0.1:5432/protecther
JWT_SECRET=change-me-min-16-chars-please-use-random
JWT_EXPIRES_SECONDS=604800
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
INVITE_TTL_HOURS=72
LOG_LEVEL=info
# Optional seed users (pnpm --filter protecther-api db:seed)
SEED_PASSWORD=SeedPass123!
# Active alerts without any contact ACK: first escalation after N minutes, then every M minutes
ALERT_ESCALATION_INTERVAL_MS=60000
ALERT_ESCALATION_NO_ACK_MINUTES=5
ALERT_ESCALATION_REPEAT_MINUTES=5
# POST /alerts/:id/location per user per minute
ALERT_LOCATION_RATE_MAX_PER_MINUTE=90
# Reject capturedAt more than this many ms before the latest point for the same alert (clock skew / abuse)
ALERT_LOCATION_CAPTURE_REGRESSION_MS=180000
# Áudio do SOS: POST /alerts/:id/audio por usuário por minuto (o app envia 1 trecho a cada ~15s)
ALERT_AUDIO_RATE_MAX_PER_MINUTE=60
# Dias que os trechos de áudio ficam guardados antes de serem apagados automaticamente
ALERT_AUDIO_RETENTION_DAYS=30
# Trechos fixados (★) ficam até este prazo, ou até alguém excluir.
ALERT_AUDIO_PINNED_RETENTION_DAYS=365
# Depois de encerrado o alerta, por quanto tempo (ms) ainda aceita trechos que ficaram na fila offline
ALERT_AUDIO_LATE_UPLOAD_WINDOW_MS=86400000
# FCM: JSON da service account Firebase (uma linha). Obrigatório para push real chegar no dispositivo.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Em NODE_ENV=development o padrão é só logar (push_dev_log). Para enviar FCM no emulador/dispositivo local:
# PUSH_USE_FCM_IN_DEV=true
