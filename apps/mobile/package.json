{
  "name": "protecther-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "node ../../node_modules/expo/bin/cli start",
    "start:dev": "node ../../node_modules/expo/bin/cli start --dev-client",
    "android": "node ../../node_modules/expo/bin/cli run:android",
    "android:build": "node ../../node_modules/expo/bin/cli run:android",
    "ios": "node ../../node_modules/expo/bin/cli run:ios",
    "ios:build": "node ../../node_modules/expo/bin/cli run:ios",
    "web": "node ../../node_modules/expo/bin/cli start --web",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@expo/dom-webview": "55.0.6",
    "@protecther/contracts": "workspace:*",
    "@protecther/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "7.2.0",
    "@react-navigation/native-stack": "7.2.0",
    "base-64": "^1.0.0",
    "expo": "~55.0.26",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-location": "~55.1.10",
    "expo-notifications": "~55.0.23",
    "expo-secure-store": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
