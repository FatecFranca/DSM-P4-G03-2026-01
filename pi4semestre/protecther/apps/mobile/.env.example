# URL da API ProtectHer (lida em app.config.ts no momento do bundle)
# Ex.: emulador Android: http://10.0.2.2:3000
# Ex.: dispositivo na mesma rede: http://192.168.x.x:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Intervalo de GPS em primeiro plano durante alerta (ms), 3000–60000
EXPO_PUBLIC_LOCATION_FG_INTERVAL_MS=5000
# Intervalo em segundo plano com TaskManager (ms), 5000–120000
EXPO_PUBLIC_LOCATION_BG_INTERVAL_MS=15000
